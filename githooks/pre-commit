#!/bin/sh
# Shared pre-commit hook — blocks credential leaks.
# Enforces the root credential-file and credential-material invariants deterministically.
# Installed per-repo by sync_agent_stubs.py using the current instruction clone's githooks directory.

fail=0

# Compose an optional project-local hook. core.hooksPath remains on this shared directory so a
# local toolchain can extend, but never replace, the credential scan below.
root=$(git rev-parse --show-toplevel) || exit 0
local_hook="$root/.githooks/pre-commit"
if [ -f "$local_hook" ]; then
  sh "$local_hook" "$@" || exit 1
fi

# 1. Block credential FILES from being committed (added/copied/modified), excluding *.example/*.sample/*.template.
cred_files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -iE '(^|/)(\.env|credentials.*\.json|token.*\.json|.*secret.*|.*\.(pem|key|p12|pfx|keystore))$' \
  | grep -ivE '^procedures/scaffold-secrets\.md$' \
  | grep -ivE '\.(example|sample|template)(\.|$)|\.env\.(example|sample|template)' \
  || true)
if [ -n "$cred_files" ]; then
  echo "BLOCKED (pre-commit): credential file(s) staged:" >&2
  echo "$cred_files" | sed 's/^/  - /' >&2
  fail=1
fi

# 2. Scan ADDED diff lines for an inline secret: a credential param assigned a QUOTED
#    literal of >=8 chars. Report only file names: echoing the matching source line would
#    expose the credential this hook is meant to contain.
secret_files=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
  [ -n "$path" ] || continue
  if git diff --cached --no-color -U0 -- "$path" \
    | grep -E '^\+' | grep -vE '^\+\+\+' \
    | grep -iE '(api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|password|[^a-z]secret)["'"'"' ]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']' \
    | grep -ivE 'example|placeholder|changeme|your[_-]|xxxx|dummy|redacted|<[^>]+>|\$\{[A-Z][A-Z0-9_]*\}' \
    >/dev/null 2>&1; then
    printf '%s\n' "$path"
  fi
done)
if [ -n "$secret_files" ]; then
  echo "BLOCKED (pre-commit): possible inline secret assignment in staged file(s); values suppressed:" >&2
  echo "$secret_files" | head -20 | sed 's/^/  - /' >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Unstage the flagged content, replace literals with typed secret configuration, or repair" >&2
  echo "a false-positive rule with a regression test in the shared hook; then retry the commit." >&2
  exit 1
fi
exit 0
