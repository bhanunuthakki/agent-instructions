#!/bin/sh
# Repository-owned privacy gate. The shared hook composes this before its
# instruction-system checks, so a public-boundary failure blocks every push.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [ -n "${PYTHON_BIN:-}" ]; then
  python_bin=$PYTHON_BIN
elif command -v python3 >/dev/null 2>&1; then
  python_bin=python3
elif command -v python >/dev/null 2>&1; then
  python_bin=python
else
  printf 'PUBLIC BOUNDARY BLOCKED: no Python interpreter; set PYTHON_BIN.\n' >&2
  exit 1
fi

if ! command -v "$python_bin" >/dev/null 2>&1; then
  printf 'PUBLIC BOUNDARY BLOCKED: PYTHON_BIN is not executable: %s\n' "$python_bin" >&2
  exit 1
fi

"$python_bin" snippets/check_public_boundary.py
