{
  "version": "1.0.0",
  "description": "Canonical registry for MCP servers synchronized across Antigravity, Gemini, Claude Code, and Codex.",
  "servers": {
    "fmp": {
      "description": "Financial Modeling Prep API server for real-time and historical financial data.",
      "targets": ["all"],
      "command": "npx.cmd",
      "args": [
        "-y",
        "mcp-remote",
        "https://financialmodelingprep.com/mcp?apikey=<FMP_API_KEY>"
      ]
    },
    "github": {
      "description": "GitHub Model Context Protocol server for issue, PR, repository, and code management.",
      "targets": ["all"],
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<GITHUB_PERSONAL_ACCESS_TOKEN>"
      }
    },
    "linear": {
      "description": "Linear MCP server for issue tracking, cycle hygiene, and PR synchronization.",
      "targets": ["all"],
      "command": "npx.cmd",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "notebooks": {
      "description": "Antigravity IDE internal notebooks bridge.",
      "targets": ["antigravity"],
      "command": "node",
      "args": [
        "c:\\Users\\Bhanu\\.antigravity-ide\\extensions\\googlecloudtools.datacloud-0.2.0-universal\\mcp_servers\\cli\\mcp_proxy_bundle.js",
        "notebooks-antigravityide"
      ]
    },
    "visualization": {
      "description": "Antigravity IDE internal visualization bridge.",
      "targets": ["antigravity"],
      "command": "node",
      "args": [
        "c:\\Users\\Bhanu\\.antigravity-ide\\extensions\\googlecloudtools.datacloud-0.2.0-universal\\mcp_servers\\cli\\mcp_proxy_bundle.js",
        "visualization-antigravityide"
      ]
    }
  }
}
