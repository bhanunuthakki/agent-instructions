# Allowlist: this repo tracks the agent-instruction system only.
# Everything else in ~/.gemini (runtime state, OAuth creds, browser profiles,
# tool homes, scratch projects) must never be committed.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/AGENTS_GUIDE.md
!/AGENT_SYSTEM_ADVERSARIAL_REVIEW_2026-07-21.md
!/DEFINITIONS.md
!/requirements-test.lock
!/procedures/
!/snippets/
!/githooks/
!/.githooks/
!/config/
!/.github/

# Machine migration, launchd, MCP topology, and runtime evidence are private.
MAC_MIGRATION_PLAN.md
docs/mac_workspace_backup.md
launchd/
snippets/backup_mac_workspace.py
snippets/test_backup_mac_workspace.py
snippets/mcp_registry.json
.private-state/
/config/*
!/config/judge_policy.json
!/config/judge_registry.json
!/config/judge_rollout.json
!/config/judge_policies/
/config/judge_policies/*
!/config/judge_policies/1.0.0.json
!/config/judge_policies/1.1.0.json
!/config/judge_registries/
/config/judge_registries/*
!/config/judge_registries/1.1.0.json
!/config/harden_state_v2.schema.json
!/config/harden_mandatory_rules.json
!/config/harden_eval_policy.json
!/config/harden_capability_registry.json
!/evals/
/evals/*
!/evals/agent_system/
/evals/agent_system/*
!/evals/agent_system/routing_cases.jsonl
!/evals/agent_system/procedure_routing_cases.jsonl
!/evals/agent_system/interaction_outcome_cases.jsonl
!/evals/agent_system/README.md
!/evals/frontend_quality/
!/evals/frontend_quality/shadow_cases.json
!/evals/harden/
/evals/harden/*
!/evals/harden/cases.jsonl
!/evals/harden/run_capability_eval.py
!/evals/harden/score_capability_eval.py
# Caches inside tracked dirs
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
