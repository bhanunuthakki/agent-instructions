#!/bin/sh
# Shared pre-push hook — composes the repository-owned gate without guessing its toolchain.
# Installed per-repo via core.hooksPath (sync_agent_stubs.py).

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 1

run() { printf '>> %s\n' "$*" >&2; "$@" || { printf 'PRE-PUSH FAILED at: %s\n' "$*" >&2; exit 1; }; }
has()  { command -v "$1" >/dev/null 2>&1; }

local_hook="$root/.githooks/pre-push"
if [ -f "$local_hook" ]; then
  # The project owns dependency policy, command order, and the validation surface.
  run sh "$local_hook" "$@"
fi

# --- Global instruction-system gate (the AGENTS.md / procedures/ system stays in sync) ---
# Runs only when pushing the instruction repository. Other repositories should not fail because
# a separate checkout's generated runtime adapters or machine inventory drifted.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
hook_repo=$(CDPATH= cd -- "$hook_dir/.." && pwd)
instructions_home=${AGENT_INSTRUCTIONS_HOME:-$hook_repo}
stubs="$instructions_home/snippets/sync_agent_stubs.py"
if [ "$root" = "$hook_repo" ]; then
  if [ -n "${PYTHON_BIN:-}" ]; then
    python_bin=$PYTHON_BIN
  elif has python3; then
    python_bin=python3
  elif has python; then
    python_bin=python
  else
    printf 'PRE-PUSH BLOCKED: no Python interpreter; set PYTHON_BIN or install python3.\n' >&2
    exit 1
  fi
  if ! has "$python_bin"; then
    printf 'PRE-PUSH BLOCKED: PYTHON_BIN is not executable: %s\n' "$python_bin" >&2
    exit 1
  fi
  if [ ! -f "$stubs" ]; then
    printf 'PRE-PUSH BLOCKED: instruction sync entrypoint is missing: %s\n' "$stubs" >&2
    exit 1
  fi
  if ! "$python_bin" -c "import pytest" >/dev/null 2>&1; then
    printf 'PRE-PUSH BLOCKED: pytest is unavailable to %s.\n' "$python_bin" >&2
    exit 1
  fi
  public_boundary="$instructions_home/snippets/check_public_boundary.py"
  if [ ! -f "$public_boundary" ]; then
    printf 'PRE-PUSH BLOCKED: public-boundary guard is missing: %s\n' "$public_boundary" >&2
    exit 1
  fi
  run "$python_bin" "$public_boundary"
  run "$python_bin" "$stubs" --check --artifacts-only
  run "$python_bin" -m pytest \
    "$instructions_home/snippets/test_guide_generation.py" \
    "$instructions_home/snippets/test_harden_state.py" \
    "$instructions_home/snippets/test_governance.py" \
    "$instructions_home/snippets/test_instruction_routing.py" \
    "$instructions_home/snippets/test_procedure_routing_eval.py" \
    "$instructions_home/snippets/test_project_agent_contract.py" \
    "$instructions_home/snippets/test_interaction_outcome_eval.py" -q
  governance="$instructions_home/snippets/judge_governance.py"
  private_state_root=${AGENT_INSTRUCTIONS_PRIVATE_STATE_ROOT:-$instructions_home/.private-state}
  ledger="$private_state_root/governance/judge_ledger.jsonl"
  if [ -f "$governance" ]; then
    run "$python_bin" "$governance" activation-check --repository-id "$(basename "$root")"
    if [ -f "$ledger" ]; then
      run "$python_bin" "$governance" audit-ledger "$ledger" --repository-id "$(basename "$root")"
    fi
    "$python_bin" "$governance" rollout-reminders >&2 || true
  fi
fi

printf 'pre-push gate passed.\n' >&2
exit 0
