#!/bin/sh
# Shared pre-push hook — runs the project gate in order; never push red.
# Enforces AGENTS.md Pre-Push Checklist deterministically. Auto-detects toolchain.
# Installed per-repo via core.hooksPath (sync_agent_stubs.py). Bypass with: git push --no-verify

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 1

run() { printf '>> %s\n' "$*" >&2; "$@" || { printf 'PRE-PUSH FAILED at: %s\n' "$*" >&2; exit 1; }; }
has()  { command -v "$1" >/dev/null 2>&1; }

local_hook="$root/.githooks/pre-push"
if [ -f "$local_hook" ]; then
  # The project hook owns its specialized gate; the shared instruction gate below still runs.
  run sh "$local_hook" "$@"
elif [ -f pyproject.toml ] || [ -f requirements.txt ]; then
  # Python: format -> lint -> typecheck(s) -> tests, in order.
  # --all-extras: plain `uv sync` PRUNES dev tools (pytest/ruff/pyright) from the venv
  # (documented AGENTS.md footgun), then the typecheck steps run against the gutted env.
  if has uv && [ -f uv.lock ]; then run uv sync --quiet --all-extras; fi
  if has ruff; then run ruff format --check .; run ruff check .; fi
  if has pyright;      then run pyright;      fi
  if has basedpyright; then run basedpyright; fi
  if has pytest;       then run pytest -q;    fi
elif [ -f package.json ]; then
  script() { node -e "process.exit((require('./package.json').scripts&&require('./package.json').scripts['$1'])?0:1)" 2>/dev/null; }
  if [ -f package-lock.json ] || [ -f pnpm-lock.yaml ] || [ -f yarn.lock ]; then run npm install --silent; fi
  if script lint;      then run npm run lint;      fi
  if script typecheck; then run npm run typecheck; fi
  if script test;      then run npm test --silent; fi
  if script build;     then run npm run build;     fi
fi

# --- Global instruction-system gate (the AGENTS.md / procedures/ system stays in sync) ---
# Runs on EVERY wired repo's push, regardless of project type: a stale or hand-edited Claude
# artifact, GEMINI trigger table, guide table, or semantic contradiction blocks the push. The
# .gemini meta-repo and every wired scratch repo use this same gate. Fix with
# /sync-agent-stubs; bypass once with git push --no-verify.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instructions_home=${AGENT_INSTRUCTIONS_HOME:-$(CDPATH= cd -- "$hook_dir/.." && pwd)}
stubs="$instructions_home/snippets/sync_agent_stubs.py"
if has python && [ -f "$stubs" ]; then
  run python "$stubs" --check
  if python -c "import pytest" >/dev/null 2>&1; then
    run python -m pytest \
      "$instructions_home/snippets/test_guide_generation.py" \
      "$instructions_home/snippets/test_governance.py" -q
  fi
  governance="$instructions_home/snippets/judge_governance.py"
  ledger="$instructions_home/governance/judge_ledger.jsonl"
  if [ -f "$governance" ]; then
    run python "$governance" activation-check --repository-id "$(basename "$root")"
    if [ "$root" = "$instructions_home" ] || [ -f "$ledger" ]; then
      run python "$governance" audit-ledger "$ledger" --repository-id "$(basename "$root")"
    fi
    python "$governance" rollout-reminders >&2 || true
  fi
fi

printf 'pre-push gate passed.\n' >&2
exit 0
